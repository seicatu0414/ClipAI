CLIPAI_ENVIRONMENT=local
CLIPAI_LOG_LEVEL=INFO
CLIPAI_DATABASE_URL=postgresql://clipai:clipai@db:5432/clipai
POSTGRES_DB=clipai
POSTGRES_USER=clipai
POSTGRES_PASSWORD=clipai
CLIPAI_MEDIA_ROOT=/data
CLIPAI_MODEL_SIZE=large-v3
CLIPAI_LANGUAGE=ja
CLIPAI_DEVICE=auto
CLIPAI_CPU_FALLBACK=true
CLIPAI_WORKER_POLL_INTERVAL_SECONDS=2
CLIPAI_EVENT_MIN_CONFIDENCE=0.55
CLIPAI_EVENT_LOUDNESS_DELTA_DB=12
CLIPAI_EVENT_SILENCE_DB=-48
CLIPAI_EVENT_SILENCE_MIN_SECONDS=2
CLIPAI_EVENT_MERGE_GAP_SECONDS=2
CLIPAI_OLLAMA_URL=http://ollama:11434
CLIPAI_OLLAMA_MODEL=qwen2.5:7b-instruct
CLIPAI_PROMPT_ROOT=/app/prompts
CLIPAI_KNOWLEDGE_MAX_HISTORICAL_HOURS=50
CLIPAI_KNOWLEDGE_MAX_REPRESENTATIVE_STREAMS=10
CLIPAI_KNOWLEDGE_CHUNK_CHARACTERS=12000
CLIPAI_CANDIDATE_TARGET_COUNT=25
CLIPAI_CANDIDATE_MINIMUM_SECONDS=15
CLIPAI_CANDIDATE_MAXIMUM_SECONDS=900
CLIPAI_CANDIDATE_ANCHOR_MAXIMUM_SECONDS=120
CLIPAI_CANDIDATE_PADDING_BEFORE_SECONDS=8
CLIPAI_CANDIDATE_PADDING_AFTER_SECONDS=12
CLIPAI_CANDIDATE_MERGE_GAP_SECONDS=8
CLIPAI_CANDIDATE_OVERLAP_THRESHOLD=0.65
CLIPAI_CANDIDATE_MAXIMUM_KNOWLEDGE_OBSERVATIONS=5
CLIPAI_CANDIDATE_CONTEXT_WINDOW_SECONDS=600
CLIPAI_CANDIDATE_MAXIMUM_CONTEXT_SECONDS=1800
CLIPAI_CANDIDATE_CONTEXT_EXPANSION_SECONDS=300
CLIPAI_CANDIDATE_DETAILED_ANALYSIS_CONFIDENCE=0.65
CLIPAI_CANDIDATE_END_BOUNDARY_COUNT=5
